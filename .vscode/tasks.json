{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Prediction server",
            "type": "shell",
            "command": "powershell -ExecutionPolicy Bypass -File \"${workspaceFolder}\\start_server.ps1\"",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "Flutter app",
            "type": "shell",
            "command": "flutter run",
            "options": {
                "cwd": "${workspaceFolder}\\flutter_app"
            },
            "problemMatcher": []
        },
        {
            "label": "Run Sugarcane classifier",
            "dependsOn": [
                "Prediction server",
                "Flutter app"
            ],
            "dependsOrder": "parallel"
        }
    ]
}
